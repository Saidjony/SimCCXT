{
  "name": "simccxt-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal TypeScript + React terminal for the simccxt Rust trading simulator",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test test/"
  },
  "dependencies": {
    "@tradingview/lwc-plugin-vertical-line": "1.0.0",
    "@tradingview/lwc-toolkit": "1.0.0",
    "fancy-canvas": "2.1.0",
    "lightweight-charts": "5.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
