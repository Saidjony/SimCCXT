# Copy to the repo root as `.vps-tunnel.env` (it is gitignored) and fill in.
# Every value can also be passed as an environment variable; CLI flags win.

# Host or ~/.ssh/config alias of the VPS. No address is stored in the repo.
VPS_HOST=

# SSH login. Leave empty if the target already contains the user.
VPS_USER=root

# SSH port (not the published one).
VPS_PORT=22

# simccxt-server on this machine and the port it gets on the VPS.
LOCAL_PORT=19010
REMOTE_PORT=19010

# 0.0.0.0 needs `GatewayPorts yes` in the VPS sshd_config.
# Use 127.0.0.1 for a loopback-only tunnel reached with `ssh -L`.
BIND=0.0.0.0

# Optional address printed as the public URL when VPS_HOST is an ssh alias.
# PUBLIC_HOST=

# Optional full ssh target, e.g. my-vps (overrides user/host/port above).
# VPS_TARGET=
